{
  "expo": {
    "name": "Wera Cocina",
    "slug": "cocina",
    "platforms": [
      "ios",
      "android"
    ],
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "orientation": "portrait",
    "icon": "../app/assets/images/icon.png",
    "scheme": "mx.wera.cocina",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "mx.wera.cocina",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "mx.wera.cocina",
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#1C6B4B",
        "foregroundImage": "../app/assets/images/android-icon-foreground.png",
        "monochromeImage": "../app/assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFCF6",
          "image": "../app/assets/images/splash-icon.png",
          "imageWidth": 140
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Wera Cocina usa la cámara para tomar las fotos de lo que publicas.",
          "photosPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "../app/assets/images/android-icon-monochrome.png",
          "color": "#1C6B4B"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8aca5e83-56a5-4b39-87b4-dd5312a54c76"
      }
    },
    "owner": "wera-app",
    "updates": {
      "url": "https://u.expo.dev/8aca5e83-56a5-4b39-87b4-dd5312a54c76"
    }
  }
}
